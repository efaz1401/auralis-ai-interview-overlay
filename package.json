{
  "name": "auralis-overlay",
  "private": true,
  "version": "0.1.0",
  "description": "Auralis AI — a transparent, always-on-top interview helper overlay built with React + Electron.",
  "author": "Auralis",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "electron": "electron electron/main.cjs",
    "electron:dev": "concurrently --kill-others -n SERVER,ELECTRON -c cyan,magenta \"tsx server.ts\" \"wait-on http://localhost:3000/api/health && cross-env ELECTRON_START_URL=http://localhost:3000 electron electron/main.cjs\"",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "cross-env NODE_ENV=production node dist/server.cjs",
    "electron:build": "npm run build && electron-builder",
    "electron:start": "cross-env NODE_ENV=production electron electron/main.cjs",
    "clean": "node -e \"for (const d of ['dist','release']) require('fs').rmSync(d, { recursive: true, force: true })\"",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "openai": "^4.77.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "ai.auralis.overlay",
    "productName": "Auralis Overlay",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  }
}
