# ── Auralis server environment ─────────────────────────────────────────────
# Copy to `.env` (never commit the real file).

# Deepgram — the ONLY speech-to-text provider. Required for live transcription.
DEEPGRAM_API_KEY=

# Optional server-side fallbacks. Users normally paste their own keys in the
# app's Settings panel; these are merged in if present.
OPENAI_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=

# ── Supabase access-key gate ────────────────────────────────────────────────
# Both required for key validation. The service-role key stays server-side and
# is NEVER shipped to the renderer.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Port for the Express server (Electron production build and `npm run dev`).
PORT=3000
